{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Python HTTP Server",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["-m", "http.server", "3002"],
      "port": 3002
    },
    {
      "name": "npx serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "3001", "."],
      "port": 3001
    },
    {
      "name": "skye-wealth-nextjs",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["start-nextjs.sh"],
      "port": 3003,
      "autoPort": false
    }
  ]
}
